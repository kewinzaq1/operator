#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library — delightful, consistent UX. Identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear — wipe the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" — opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later — it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" — clear the screen, then announce a stage and show progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." — a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." — a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL — open in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser — visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser — visit it manually: $url"
}

# pause "msg" — wait for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" — y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY — current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" — read a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" — like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE — upsert KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE — set a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name — gh not ready; set it later"
}

# set_var NAME VALUE — set a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name — gh not ready; set it later"
}

# finish — clear, then a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES — author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=9
ORGANIZER_FILE="${ORGANIZER_FILE:-tmp/hackathon-organizer.env}"
mkdir -p tmp

banner "Zero Human Company — Operator credentials"

# ── 1. Team name ──────────────────────────────────────────────────────────
stage "Team name"
say "Organizers track revenue by team. Use the name you'll put on the submission form."
ask HACKATHON_TEAM_NAME "Team name:"
write_env HACKATHON_TEAM_NAME "$HACKATHON_TEAM_NAME"

# ── 2. Stripe account ─────────────────────────────────────────────────────
stage "Stripe — personal account"
say "Best Overall Agent-Run Company requires YOUR personal Stripe account so"
say "organizers can see revenue. A personal account is enough. Skip business docs"
say "unless Stripe blocks you."
open_url "https://dashboard.stripe.com/register"
step "Sign up with an email you can reach today."
step "Finish enough of onboarding to land in the Dashboard."
pause "Press Enter once you can see the Stripe Dashboard."

# ── 3. Payment Link ───────────────────────────────────────────────────────
stage "Stripe — Payment Link"
say "The agent sends this SAME link for every charge today. Customer chooses the amount."
open_url "https://dashboard.stripe.com/payment-links"
step "Click + Create payment link."
step "Product name: Operator session (Anna Fitness) — or '[Your Team] Payment'."
step "Price: choose Customer chooses price (so 80 zł / 70 zł / tips all work)."
step "Create link, then copy the URL (starts with https://buy.stripe.com/)."
ask STRIPE_PAYMENT_LINK_URL "Paste the Payment Link URL:"
write_env STRIPE_PAYMENT_LINK_URL "$STRIPE_PAYMENT_LINK_URL"
write_env DEMO_MODE "false"

# ── 4. Restricted key for organizers ──────────────────────────────────────
stage "Stripe — restricted key for organizers"
say "This key is READ-ONLY. Organizers use it to see charges. Never share sk_."
open_url "https://dashboard.stripe.com/apikeys"
step "Click Create restricted key."
step "Name it hackathon-readonly."
step "Set Balance = Read and Charges = Read. Everything else = None."
step "Create key. Copy it (starts with rk_). You will not see it again."
ask_secret STRIPE_RESTRICTED_KEY "Paste the restricted key (rk_):"
{
  grep -vE "^(HACKATHON_TEAM_NAME|STRIPE_PAYMENT_LINK_URL|STRIPE_RESTRICTED_KEY)=" "$ORGANIZER_FILE" > "${ORGANIZER_FILE}.tmp" 2>/dev/null || true
  printf 'HACKATHON_TEAM_NAME=%s\n' "$HACKATHON_TEAM_NAME" >> "${ORGANIZER_FILE}.tmp"
  printf 'STRIPE_PAYMENT_LINK_URL=%s\n' "$STRIPE_PAYMENT_LINK_URL" >> "${ORGANIZER_FILE}.tmp"
  printf 'STRIPE_RESTRICTED_KEY=%s\n' "$STRIPE_RESTRICTED_KEY" >> "${ORGANIZER_FILE}.tmp"
  mv "${ORGANIZER_FILE}.tmp" "$ORGANIZER_FILE"
}
note "saved organizer packet → $ORGANIZER_FILE  (gitignored — do not commit)"

# ── 5. App secret key (optional) ──────────────────────────────────────────
stage "Stripe — secret key for Operator"
say "Needed only if you want Checkout Sessions / webhooks besides the Payment Link."
say "The guidebook payment link works without this. Skip unless you have it."
if confirm "Set a Stripe secret key (sk_) now?"; then
  open_url "https://dashboard.stripe.com/apikeys"
  step "Reveal the Secret key (starts with sk_live_ or sk_test_)."
  warn "Do NOT give this key to organizers. Only the rk_ key."
  ask_secret STRIPE_SECRET_KEY "Paste the secret key:"
  write_env STRIPE_SECRET_KEY "$STRIPE_SECRET_KEY"
else
  note "skipped — Payment Link is enough for the prize path"
fi

# ── 6. Terac ──────────────────────────────────────────────────────────────
stage "Terac — API key (required to submit)"
say "Operator launches a General Population study to pick the better rebooking message,"
say "then uses the winning copy. That is the required Terac human-in-the-loop."
open_url "https://terac.com"
step "Sign in with the hackathon Terac credits from the Notion keys doc."
step "Organization settings → API Keys → create a key (starts with tk_)."
ask_secret TERAC_API_KEY "Paste the Terac API key:"
write_env TERAC_API_KEY "$TERAC_API_KEY"

# ── 7. Linq (optional) ────────────────────────────────────────────────────
stage "Linq — messaging (optional, Best use of Linq)"
say "Linq gives the agent a real iMessage/RCS/SMS number. Skip if you have no token yet."
if confirm "Set Linq credentials now?"; then
  open_url "https://docs.linqapp.com/getting-started/quickstart/"
  step "Paste the bearer token your Linq rep provisioned."
  ask_secret LINQ_API_TOKEN "Linq API token:"
  ask LINQ_PHONE_NUMBER "Linq phone number (E.164, or Enter to skip):"
  write_env LINQ_API_TOKEN "$LINQ_API_TOKEN"
  [[ -n "${LINQ_PHONE_NUMBER:-}" ]] && write_env LINQ_PHONE_NUMBER "$LINQ_PHONE_NUMBER"
else
  note "skipped — demo messaging still runs"
fi

# ── 8. Render Workflows (optional, Best use of Render) ────────────────────
stage "Render — Workflows + API key"
say "Best use of Render requires Workflows, not only a web service."
say "After this wizard: Dashboard → New → Workflow → repo root Directory workflows/"
say "Start command: python main.py"
open_url "https://dashboard.render.com"
if confirm "Set Render API key now?"; then
  open_url "https://dashboard.render.com/u/settings?add-api-key"
  step "Create an API key (starts with rnd_)."
  ask_secret RENDER_API_KEY "Render API key:"
  ask RENDER_TASK_SLUG "Task slug after deploy (e.g. operator-workflow/run_daily_business), or Enter later:"
  TOKEN=$(openssl rand -hex 16)
  write_env RENDER_API_KEY "$RENDER_API_KEY"
  write_env OPERATOR_JOB_TOKEN "$TOKEN"
  [[ -n "${RENDER_TASK_SLUG:-}" ]] && write_env RENDER_TASK_SLUG "$RENDER_TASK_SLUG"
  note "OPERATOR_JOB_TOKEN generated for the workflow → Rails callback"
else
  note "skipped — Run my business still runs as a local Rails job"
fi

# ── 9. Organizer packet ───────────────────────────────────────────────────
stage "Submit to organizers"
say "Give organizers ONLY these three things (not your sk_ key):"
printf '\n'
printf '  Team name:        %s\n' "$HACKATHON_TEAM_NAME"
printf '  Payment Link URL: %s\n' "$STRIPE_PAYMENT_LINK_URL"
printf '  Restricted key:   %s\n' "(saved in $ORGANIZER_FILE — starts with rk_)"
printf '\n'
step "Paste those into the hackathon payment submission form from the guidebook."
note "Then restart the app so .env loads:  PORT=3040 bin/rails server"
pause "Press Enter after you've copied the three fields."

finish
printf '  Organizer packet: %s\n' "$ORGANIZER_FILE"
printf '  Next: bin/rails server   then click Run my business.\n\n'
